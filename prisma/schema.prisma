// Logistics CMS — database schema (PostgreSQL / Supabase)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A logist (company employee) who can sign in to the CMS.
model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(200)
  passwordHash String        @db.VarChar(200)
  /// "ADMIN" or "LOGIST"
  role         String        @default("LOGIST") @db.VarChar(20)
  /// Avatar color key used in the UI: blue | rose | amber | violet | green | slate
  color        String        @default("blue") @db.VarChar(20)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  drivers      Driver[]
  checks       NumberCheck[]
}

/// Destination category shown as a tab on the dashboard (Turkey, Russia, ...).
model Destination {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  drivers   Driver[]
}

model Driver {
  id           Int           @id @default(autoincrement())
  /// Always stored normalized as E.164, e.g. "+995599123456". Unique = no duplicates.
  phone        String        @unique @db.VarChar(20)
  name         String        @db.VarChar(150)
  truckType    String        @db.VarChar(100)
  description  String?       @db.VarChar(2000)
  logistId     Int
  logist       User          @relation(fields: [logistId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destinations Destination[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([logistId])
  @@index([createdAt])
}

/// History of "Check number" lookups, shown as "Your recent checks".
model NumberCheck {
  id        Int      @id @default(autoincrement())
  phone     String   @db.VarChar(20)
  found     Boolean
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
